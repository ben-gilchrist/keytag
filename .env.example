# Copy these into Vercel: Project → Settings → Environment Variables.
# Never put the service role key, Twilio token or Resend key anywhere public.

SITE_URL=https://keytag.co.uk

# Supabase → Project Settings → API
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio → Console home (Account SID, Auth Token) and your UK mobile number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+447xxxxxxxxx

# Resend → API Keys
RESEND_API_KEY=
EMAIL_FROM=Keytag <hello@keytag.co.uk>

# Who gets admin emails and can open /admin (comma-separated)
ADMIN_EMAILS=ben@bengilchrist.co.uk

# Shopify cart link for the Keytag product. {QTY} is filled in by the site.
# Leave empty to show "opening soon" instead of checkout.
SHOP_CHECKOUT_URL=https://your-store.myshopify.com/cart/VARIANT_ID:{QTY}
